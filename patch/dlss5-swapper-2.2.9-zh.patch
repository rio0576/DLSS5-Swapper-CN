+    OT,
+    hotkeyFooter,
+    lang: current,
+    isChinese,
+    // From the panel window's IPC channel. Announced before anything renders.
+    set(code) {
+      const next = String(code || 'en');
+      if (next === runtimeLang) return;
+      runtimeLang = next;
+      for (const fn of listeners) fn(next);
+    },
+    onChange(fn) { listeners.push(fn); },
+    strings: ZH,
+  };
